{
  "name": "naz-coffee-web",
  "version": "2.0.0",
  "private": true,
  "description": "NAZ Coffee website: brand landing page and online ordering, with server-side order validation.",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.cpSync('shared', 'public/shared', { recursive: true }));\"",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node --check server/server.js && node --test \"tests/**/*.test.js\""
  }
}
