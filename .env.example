# Copy to .env and adjust. Nothing here is a secret, but keep .env out of version control.

PORT=3000

# dry-run (default): orders are validated and logged, but NOT sent anywhere.
# live: orders go to the existing NAZ order board, rewards backend and Google Form.
NAZ_MODE=dry-run

# Existing NAZ order backend (RPC endpoint taking { action, args }).
NAZ_UPSTREAM_URL=https://naz-coffee-order.ptsutare.chatgpt.site/api/naz

# In dry-run, still read live menu availability from the backend (read-only). on | off
NAZ_UPSTREAM_READS=on

# Google Form that receives the backup copy of every order (live mode only). on | off
NAZ_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScWhndqPpP7k7Kt-89JiTpwBoMVBGzC0DfosVmDAwBLP2ymLg/formResponse
NAZ_GOOGLE_FORM_SUBMIT=on

# Set to "on" behind a reverse proxy / CDN so rate limits see the real client IP.
TRUST_PROXY=off

LOG_LEVEL=info
